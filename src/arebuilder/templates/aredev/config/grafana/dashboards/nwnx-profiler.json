          "sort": "none"
        }
      },
      "targets": [
        {
          "alias": "Tick rate",
          "datasource": {
            "type": "influxdb",
            "uid": "nwnx-profiler"
          },
          "query": "SELECT mean(\"Count\") FROM \"NWNX_Profiler.GameTickRate\" WHERE $timeFilter GROUP BY time(1s) fill(null)",
          "rawQuery": true,
          "refId": "A",
          "resultFormat": "time_series"
        }
      ],
      "title": "Game tick rate",
      "type": "timeseries"
